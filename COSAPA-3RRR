<!-- ============ FORMULARIO ============ -->
<section class="sec" id="formulario" style="background:linear-gradient(180deg,#F7F1E4,#EFE7D6)">
  <span class="aura" style="width:360px;height:360px;background:rgba(184,242,74,.35);top:20px;left:-90px"></span>
  <div class="wrap">
    <div class="sec-head rv">
      <span class="eyebrow"><span data-icon="edit" class="ic"></span> Documento final</span>
      <h2 class="sec-title">Formulario de requerimientos <em>ECO 3R</em></h2>
      <p class="sec-sub">Completa los cuatro pasos. El documento se guarda solo en este dispositivo, se puede descargar en JSON, imprimir en PDF o enviar al equipo de desarrollo con un folio de seguimiento.</p>
    </div>
    <div class="form-grid">
      <div class="form-card rv">
        <div class="steps inner-scroll dark-scroll" id="steps"></div>
        <div class="step-body">
          <!-- PASO 1 -->
          <div class="fpane on" data-pane="1">
            <h3 style="font-size:1.35rem;margin-bottom:6px">1 · Datos del solicitante</h3>
            <p class="small muted" style="margin-bottom:20px">Identifica al responsable del requerimiento dentro del proyecto BTH.</p>
            <div class="f2">
              <div class="field" id="f-nombre"><label>Nombre y apellido *</label><input type="text" data-bind="form.nombre" placeholder="Ej: Ana Quispe Mamani"><span class="err">Ingresa tu nombre completo (mínimo 3 caracteres).</span></div>
              <div class="field" id="f-institucion"><label>Unidad educativa / institución *</label><input type="text" data-bind="form.institucion" placeholder="Ej: U.E. Técnico Humanístico"><span class="err">Indica la institución.</span></div>
            </div>
            <div class="f2">
              <div class="field" id="f-correo"><label>Correo electrónico *</label><input type="email" data-bind="form.correo" placeholder="nombre@correo.com"><span class="err">Correo no válido.</span></div>
              <div class="field" id="f-telefono"><label>Teléfono / WhatsApp *</label><input type="tel" data-bind="form.telefono" placeholder="+591 7XXXXXXX"><span class="err">Ingresa al menos 7 dígitos.</span></div>
            </div>
            <div class="f3">
              <div class="field"><label>Rol en el proyecto</label><select data-bind="form.rol"><option>Estudiante / Equipo BTH</option><option>Docente asesor</option><option>Coordinación académica</option><option>Emprendedor aliado</option><option>Organización ambiental</option></select></div>
              <div class="field"><label>Ciudad</label><select data-bind="form.ciudad"><option>La Paz</option><option>El Alto</option><option>Cochabamba</option><option>Santa Cruz</option><option>Oruro</option><option>Potosí</option><option>Sucre</option><option>Tarija</option><option>Trinidad</option><option>Cobija</option></select></div>
              <div class="field"><label>Fecha del requerimiento</label><input type="date" data-bind="form.fecha"></div>
            </div>
            <div class="field"><label>Área del proyecto</label><input type="text" data-bind="form.area" placeholder="Sistemas Informáticos – Proyecto BTH"></div>
          </div>
          <!-- PASO 2 -->
          <div class="fpane" data-pane="2">
            <h3 style="font-size:1.35rem;margin-bottom:6px">2 · Alcance y módulos</h3>
            <p class="small muted" style="margin-bottom:18px">Se sincroniza con el tablero de módulos de la sección 3. Puedes ajustarlo aquí mismo.</p>
            <div class="field"><label>Modalidades requeridas</label>
              <div class="f2">
                <label class="check"><input type="checkbox" data-bind="form.web"><span><b>Página web responsive</b><br><span class="xsmall muted">PC, tablet y celular</span></span></label>
                <label class="check"><input type="checkbox" data-bind="form.android"><span><b>Aplicación Android</b><br><span class="xsmall muted">13 pantallas nativas</span></span></label>
              </div>
            </div>
            <div class="f2">
              <div class="field"><label>Nivel de alcance</label><select data-bind="form.alcance"><option>Prototipo navegable (demo)</option><option selected>Producto mínimo viable (MVP)</option><option>Plataforma completa con pagos</option></select></div>
              <div class="field"><label>Usuarios estimados el primer año</label><select data-bind="form.usuarios"><option>Menos de 100</option><option selected>100 a 500</option><option>500 a 2.000</option><option>Más de 2.000</option></select></div>
            </div>
            <div class="field"><label>Módulos incluidos y prioridad</label><div id="form-mods"></div></div>
            <div class="field"><label>Categorías iniciales del catálogo</label><div class="chips" id="form-cats"></div></div>
          </div>
          <!-- PASO 3 -->
          <div class="fpane" data-pane="3">
