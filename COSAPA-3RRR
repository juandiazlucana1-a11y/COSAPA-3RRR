function effort(){
 let h=0;MODULES.forEach(m=>{const st=S.mods[m.id];if(!st.on)return;const f=st.pri==='Esencial'?1:st.pri==='Importante'?.8:.5;const done=st.reqs.filter(Boolean).length/st.reqs.length;h+=m.h*f*(0.5+0.5*done);});
 if(S.form.android) h*=1.3; if(!S.form.web) h*=.7;
 if(S.form.tutoriales) h+=10; if(S.form.fotosPropias) h+=8; if(S.form.bilingue) h+=14;
 if(S.stack.android==='pwa') h*=.82; if(S.stack.front==='react') h*=1.08; if(S.stack.db==='mongo') h*=1.15;
 return Math.round(h);
}

