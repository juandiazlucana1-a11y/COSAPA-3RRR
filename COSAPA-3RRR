function authSubmit(mode){
 const err=$('#auth-err');
 if(mode==='login'){
  const mail=$('#auth-mail').value.trim().toLowerCase(),pass=$('#auth-pass').value;
  const u=S.users.find(x=>x.correo.toLowerCase()===mail);
  if(!u){err.textContent='No existe una cuenta con ese correo.';return;}
  if(pass!=='eco3r123'&&pass.length<6){err.textContent='Contraseña incorrecta (demo: eco3r123).';return;}
  if(u.estado!=='activo'){err.textContent='Cuenta suspendida. Contacta al administrador.';return;}
  S.session=u.id; closeModal(); save(); renderTabs(); setTab(S.tab); toast('Bienvenida/o, '+u.nombre,{icon:'user'});
 }else{
  const n=$('#reg-name').value.trim(),m=$('#reg-mail').value.trim(),p=$('#reg-pass').value,r=$('#reg-role').value,c=$('#reg-city').value.trim(),b=$('#reg-biz').value.trim();
  if(n.length<3){err.textContent='Escribe tu nombre completo.';return;}
  if(!/^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(m)){err.textContent='Correo no válido.';return;}
  if(S.users.some(x=>x.correo.toLowerCase()===m.toLowerCase())){err.textContent='Ese correo ya está registrado.';return;}
  if(p.length<6){err.textContent='La contraseña debe tener al menos 6 caracteres.';return;}
  if(!$('#reg-terms').checked){err.textContent='Debes aceptar las políticas.';return;}
  const u={id:uid('usr'),nombre:n,negocio:r==='vendedor'?(b||n):'',correo:m,rol:r,ciudad:c||'La Paz',telefono:'',desc:'',verificado:false,rating:0,estado:'activo'};
  S.users.push(u); S.session=u.id; closeModal(); save(); renderTabs(); renderAdmin(); setTab('perfil'); toast('Cuenta creada como '+r+'. ¡Bienvenida/o!',{icon:'check'});
 }
}

