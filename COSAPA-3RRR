<!-- ============ 1-2 PROYECTO ============ -->
<section class="sec" id="proyecto">
  <span class="aura" style="width:340px;height:340px;background:rgba(127,227,176,.35);top:40px;right:-80px"></span>
  <div class="wrap">
    <div class="sec-head rv">
