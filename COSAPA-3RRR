function confetti(x,y){
 if(reduceMotion) return;
 const cols=['#B8F24A','#25A15F','#F5A524','#2E9BD6','#E4572E','#7FE3B0'];
 for(let i=0;i<26;i++){
  const s=document.createElement('span'); s.className='confetti';
  s.style.background=cols[i%cols.length]; s.style.left=x+'px'; s.style.top=y+'px';
  document.body.appendChild(s);
  const ang=Math.random()*Math.PI*2, dist=60+Math.random()*170;
  s.animate([{transform:'translate(0,0) rotate(0deg)',opacity:1},{transform:'translate('+Math.cos(ang)*dist+'px,'+(Math.sin(ang)*dist+130)+'px) rotate('+(Math.random()*720-360)+'deg)',opacity:0}],
   {duration:900+Math.random()*600,easing:'cubic-bezier(.2,.7,.3,1)'}).onfinish=()=>s.remove();
 }
}

