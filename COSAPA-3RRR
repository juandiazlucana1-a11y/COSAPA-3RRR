        <div class="dev"><div class="dev-bar"><i></i><i></i><i></i></div><div class="dev-body" id="dev-web"></div></div>
      </div>
      <div class="mod-card app rv">
        <span class="badge b-warn"><span data-icon="phone" class="ic" style="width:14px;height:14px"></span> Modalidad 2</span>
        <h3 style="margin:12px 0 8px;font-size:1.4rem">Aplicación Android</h3>
        <p class="muted small">App nativa con las 13 pantallas definidas, notificaciones de aprobación y acceso al mismo catálogo en tiempo real.</p>
        <div class="mini-phone"><img id="mini-phone-img" alt="Vista previa de la aplicación Android ECO 3R"></div>
