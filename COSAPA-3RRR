let toastTimer=[];
function toast(msg,opt){
 opt=opt||{};
 const t=document.createElement('div');
 t.className='toast '+(opt.tone||'ok');
 t.innerHTML='<span class="ic">'+icon(opt.icon||'check')+'</span><span style="flex:1">'+esc(msg)+'</span>';
 if(opt.action){ const b=document.createElement('button'); b.textContent=opt.action; b.onclick=()=>{opt.onAction&&opt.onAction(); remove();}; t.appendChild(b); }
 $('#toasts').appendChild(t);
 const remove=()=>{ if(!t.parentNode)return; t.classList.add('out'); setTimeout(()=>t.remove(),300); };
 const timer=setTimeout(remove,opt.ms||4800); toastTimer.push(timer);
 if(toastTimer.length>40) toastTimer=toastTimer.splice(0,20);
 return remove;
}
