function goStep(n){
 n=clamp(n,1,4);
 if(n>S.step&&!validStep(S.step,true)) return;
 S.step=n;
 $$('.fpane').forEach(p=>p.classList.toggle('on',Number(p.dataset.pane)===n));
 $$('#steps .step').forEach((b,i)=>{b.classList.toggle('on',i+1===n);b.classList.toggle('ok',i+1<n);});
 $('#btn-prev').disabled=n===1;
 $('#btn-next').innerHTML=n===4?'<span class="ic">'+icon('check')+'</span> Revisar y enviar':'Siguiente <span class="ic">'+icon('arrow')+'</span>';
 hydrateIcons($('#btn-next'));
 save(); updateSummary();
 const card=$('.form-card'); if(card){const y=card.getBoundingClientRect().top+window.scrollY-90;window.scrollTo({top:y,behavior:reduceMotion?'auto':'smooth'});}
}
function validStep(n,show){
 if(n!==1) return true;
 const f=S.form; let ok=true;
 const checks=[['#f-nombre',f.nombre.trim().length>=3],['#f-institucion',f.institucion.trim().length>=2],
  ['#f-correo',/^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(f.correo.trim())],['#f-telefono',(f.telefono.replace(/\D/g,'').length>=7)]];
 checks.forEach(c=>{ if(show) badField(c[0],!c[1]); ok=ok&&c[1]; });
 if(!ok&&show) toast('Completa los datos del solicitante para continuar',{tone:'err',icon:'x'});
 return ok;
}
function completion(){
 const f=S.form;
 const items=[f.nombre.trim().length>=3,f.institucion.trim().length>=2,/^[^\s@]+@[^\s@]+\.[a-z]{2,}$/i.test(f.correo),f.telefono.replace(/\D/g,'').length>=7,
  f.web||f.android,MODULES.some(m=>S.mods[m.id].on),!!f.alcance,!!f.plazo,f.estilo!=='',f.moderacion&&f.roles&&f.datos,f.firma.trim().length>=3,f.acepta];
 return Math.round(items.filter(Boolean).length/items.length*100);
}
function updateSummary(){
 const f=S.form,on=MODULES.filter(m=>S.mods[m.id].on);
 const reqs=on.reduce((a,m)=>a+S.mods[m.id].reqs.filter(Boolean).length,0);
 const h=effort(),weeks=Math.max(2,Math.ceil(h/36)),pct=completion();
 $('#mod-count').textContent=on.length; $('#req-count').textContent=reqs; $('#eff-count').textContent=h+' h';
 $('#ring-pct').textContent=pct+'%'; $('#nav-pct').textContent=pct+'%';
 $('#ring-fg').style.strokeDashoffset=String(263.9*(1-pct/100));
 $('#sum-chips').innerHTML=on.map(m=>'<i>'+m.id+' · '+esc(m.n.split(':')[0])+'</i>').join('');
 $('#sum-rows').innerHTML=[
  ['Solicitante',f.nombre||'—'],['Institución',f.institucion||'—'],['Contacto',f.correo||'—'],
  ['Modalidades',[f.web?'Web':null,f.android?'Android':null].filter(Boolean).join(' + ')||'Ninguna'],
  ['Alcance',f.alcance],['Requerimientos',reqs+' de 48'],['Plazo',f.plazo],
  ['Esfuerzo estimado',h+' h · '+weeks+' sem'],['Herramientas','Bs 0 / mes'],
  ['Pagos reales',f.pagos==='fase2'?'Fase 2':f.pagos==='fase1'?'Fase 1':'No incluidos']
 ].map(r=>'<div class="sum-row"><span>'+esc(r[0])+'</span><b>'+esc(r[1])+'</b></div>').join('');
 $('#budget-label').textContent=money(f.presupuesto);
 const note=f.presupuesto===0?'Perfecto: la ruta seleccionada funciona íntegramente con capas gratuitas.':
  f.presupuesto<1500?'Suficiente para dominio propio y una cuota pequeña de almacenamiento.':
  f.presupuesto<3500?'Permite dominio, plan de base de datos y pasarela de pagos en fase 2.':'Presupuesto holgado: incluye hosting pago, publicidad y sesión fotográfica profesional.';
 $('#budget-note').innerHTML='<span class="badge '+(f.presupuesto===0?'b-ok':'b-info')+'">'+(f.presupuesto===0?'Costo cero':'Con presupuesto')+'</span> <span class="muted">'+note+'</span>';
 renderFormMods(); renderStack();
}
