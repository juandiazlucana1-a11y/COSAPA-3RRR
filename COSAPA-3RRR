 if(on){ phoneTimer=setInterval(()=>{S.phone=(S.phone+1)%SCREENS.length;renderPhone();},3200); }
 $('#phone-play').innerHTML='<span class="ic">'+icon(on?'pause':'play')+'</span> '+(on?'Detener recorrido':'Recorrido automático');
