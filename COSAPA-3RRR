}

/* ---------- SCHEMA / STACK ---------- */
function renderSchema(){
 const c=SCHEMA[S.coll];
 $('#coll-name').textContent=c.c; $('#coll-desc').textContent=c.d; $('#coll-count').textContent=c.f.length+' campos';
 $('#coll-fields').innerHTML=c.f.map(f=>'<tr><td class="mono" style="color:var(--leaf)">'+esc(f[0])+'</td><td><span class="badge b-neutral">'+esc(f[1])+'</span></td><td class="xsmall muted">'+esc(f[2])+'</td></tr>').join('');
 const json=JSON.stringify(c.doc,null,2)
  .replace(/&/g,'&amp;').replace(/</g,'&lt;')
  .replace(/"([^"]+)":/g,'<span class="k">"$1"</span>:')
  .replace(/: "([^"]*)"/g,': <span class="s">"$1"</span>')
  .replace(/: (\d+\.?\d*)/g,': <span class="n">$1</span>')
  .replace(/: (true|false)/g,': <span class="b">$1</span>');
 $('#coll-json').innerHTML='<div style="color:#7FE3B0;margin-bottom:8px">// documento de ejemplo · colección '+esc(c.c)+'</div><pre style="margin:0;white-space:pre-wrap">'+json+'</pre>';
 $$('#coll-list .coll').forEach((b,i)=>b.classList.toggle('on',i===S.coll));
}
function renderStack(){
 $('#stack-groups').innerHTML=STACK.map(g=>'<div class="sgroup"><h4><span class="ic" style="color:var(--lima)">'+icon(g.ic)+'</span>'+esc(g.t)+'</h4><div class="opts">'+
  g.o.map(o=>'<button class="opt'+(S.stack[g.g]===o.id?' on':'')+'" data-act="stack-pick" data-g="'+g.g+'" data-o="'+o.id+'"><b>'+esc(o.n)+'</b><p>'+esc(o.why)+'</p><span class="cost">'+esc(o.c)+' · '+esc(o.pro)+'</span></button>').join('')+'</div></div>').join('');
 const picked=STACK.map(g=>g.o.find(o=>o.id===S.stack[g.g])).filter(Boolean);
 $('#stack-title').textContent=picked.map(p=>p.n.split(' (')[0]).join(' + ');
 $('#stack-why').textContent='Ruta elegida: '+picked.map(p=>p.pro.toLowerCase()).join(', ')+'. '+picked.map(p=>p.why.split(';')[0]).join('. ')+'.';
 const paid=picked.some(p=>/limitado|freemium|cuota/i.test(p.c));
 $('#stack-cost').textContent=paid?'Bs 0 en la capa gratuita':'Bs 0 / mes';
 const h=effort(); $('#stack-eff').textContent=h+' horas';
 $('#stack-weeks').textContent=Math.max(2,Math.ceil(h/36))+' semanas';
 $('#stack-scale').textContent=S.stack.db==='firebase'?'Alta · tiempo real':S.stack.db==='supabase'?'Alta · SQL':'Media · API propia';
 const total=12;
 $('#gantt').innerHTML=PHASES.map(p=>'<div class="grow2"><span>'+esc(p.n)+'</span><div class="gtrack"><i class="gfill" style="left:'+(p.s/total*100)+'%;width:'+(p.d/total*100)+'%;background:'+p.c+'"></i></div><span class="mono xsmall">'+p.d+' sem</span></div>').join('');
 hydrateIcons($('#stack-groups'));
}

