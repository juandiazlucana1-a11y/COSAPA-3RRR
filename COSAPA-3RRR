    modulos:MODULES.filter(m=>S.mods[m.id].on).map(m=>({id:m.id,nombre:m.n,prioridad:S.mods[m.id].pri,requerimientos:m.reqs.filter((r,i)=>S.mods[m.id].reqs[i])})),
    diseno:{estilo:S.form.estilo,paleta:S.form.paleta,colores:PALETTE.map(p=>p.h),idioma:S.form.idioma,tutoriales:S.form.tutoriales,logoNuevo:S.form.logoNuevo,fotosPropias:S.form.fotosPropias,bilingue:S.form.bilingue},
    plazos:{plazo:S.form.plazo,presupuestoBs:S.form.presupuesto,esfuerzoHoras:effort(),semanas:Math.max(2,Math.ceil(effort()/36))},
    seguridad:{pagos:S.form.pagos,respaldo:S.form.respaldo,moderacion:S.form.moderacion,panelRestringido:S.form.roles,proteccionDatos:S.form.datos,controles:S.sec},
    tecnologias:STACK.reduce((o,g)=>{const x=g.o.find(y=>y.id===S.stack[g.g]);o[g.g]=x?x.n:'';return o;},{}),
    pantallasAndroid:SCREENS.map((s,i)=>(i+1)+'. '+s.n),observaciones:S.form.observaciones,firma:{nombre:S.form.firma,cargo:S.form.cargo,conformidad:S.form.acepta}};
   download('eco3r-requerimientos.json',JSON.stringify(data,null,2),'application/json'); toast('JSON del requerimiento descargado',{icon:'download'}); break; }
  case 'form-print': buildPrint(); setTimeout(()=>window.print(),120); break;
  case 'form-copy':{ const t=summaryText();
   if(navigator.clipboard&&navigator.clipboard.writeText){ navigator.clipboard.writeText(t).then(()=>toast('Resumen copiado al portapapeles',{icon:'copy'})).catch(()=>download('eco3r-requerimientos.txt',t)); }
   else download('eco3r-requerimientos.txt',t); break; }
  case 'form-submit': submitForm(); break;
  case 'form-reset':{
   openModal('Vaciar formulario','<p class="small">Se borrarán los datos del solicitante y las respuestas. Los módulos volverán a su configuración inicial. Esta acción no se puede deshacer.</p>',
    '<button class="btn" data-act="modal-close">Cancelar</button><button class="btn btn-danger" data-act="form-reset-ok">Sí, vaciar</button>'); break; }
  case 'form-reset-ok':{ S.form=defaultForm(); S.sent=null; MODULES.forEach(m=>{S.mods[m.id]={on:true,pri:'Esencial',reqs:m.reqs.map(()=>true)};});
   $('#submit-result').innerHTML=''; $$('.field').forEach(f=>f.classList.remove('bad')); closeModal(); save(); syncFormInputs(); renderModules(); goStep(1); toast('Formulario reiniciado',{icon:'refresh'}); break; }
 }
});
/* bindings */
function onBind(e){
 const t=e.target;
 if(t.dataset.act==='mod-req'){ const m=t.dataset.m,i=Number(t.dataset.i); S.mods[m].reqs[i]=t.checked; t.closest('.req').classList.toggle('done',t.checked); updateSummary(); save(); return; }
 if(t.dataset.act==='mod-pri'){ S.mods[t.dataset.m].pri=t.value; updateSummary(); save(); renderModules(); return; }
 if(t.dataset.act==='mod-toggle-cb'){ S.mods[t.dataset.m].on=t.checked; renderModules(); save(); return; }
 if(t.dataset.act==='pub-sel'){ const id=t.dataset.id; S.sel=t.checked?S.sel.concat([id]):S.sel.filter(x=>x!==id); renderMy(); return; }
 if(t.dataset.act==='pub-sel-all'){ const u=currentUser(); if(!u)return; const mine=S.products.filter(p=>p.vendedorId===u.id); S.sel=t.checked?mine.map(p=>p.id):[]; renderMy(); return; }
 if(t.dataset.act==='adm-role'){ const u=userById(t.dataset.id); u.rol=t.value; save(); renderAdmin(); renderTabs(); toast('Rol de '+u.nombre+' → '+u.rol,{icon:'shield'}); return; }
 if(t.dataset.act==='session-switch'){ S.session=t.value; save(); renderTabs(); setTab(S.tab); toast(t.value?'Sesión: '+userById(t.value).nombre:'Navegando como invitado',{icon:'user'}); return; }
 if(t.dataset.act==='photo-upload'){ const f=t.files&&t.files[0]; if(!f)return;
  const rd=new FileReader(); rd.onload=()=>{ const im=new Image(); im.onload=()=>{ const cv=document.createElement('canvas');
   const sc=Math.min(1,760/Math.max(im.width,im.height)); cv.width=Math.round(im.width*sc); cv.height=Math.round(im.height*sc);
   cv.getContext('2d').drawImage(im,0,0,cv.width,cv.height);
   S.pub.foto=cv.toDataURL('image/jpeg',0.82); fillPubForm(); toast('Fotografía cargada y optimizada',{icon:'camera'}); };
   im.onerror=()=>toast('No se pudo leer la imagen',{tone:'err',icon:'x'}); im.src=rd.result; };
  rd.readAsDataURL(f); return; }
 const path=t.dataset.bind; if(!path) return;
 let v; if(t.type==='checkbox') v=t.checked; else if(t.type==='number'||t.type==='range') v=t.value===''?'':Number(t.value); else v=t.value;
 if(path.startsWith('profile.')) return;
 setPath(S,path,v);
 if(path==='catalog.tipo'){ S.catalog.cat='todas'; renderCatalog(); }
 else if(path.startsWith('catalog.')) renderCatalog();
 if(path.startsWith('pub.')) updatePubPreview();
 if(path.startsWith('form.')){ const f=t.closest('.field'); if(f)f.classList.remove('bad'); updateSummary(); }
 save();
}
document.addEventListener('input',onBind);
document.addEventListener('change',onBind);
document.addEventListener('keydown',e=>{
 if(e.key==='Escape'){ closeModal(); closeDrawer(); $('#mobile').classList.remove('open'); }
 if(e.key==='Enter'&&e.target&&e.target.matches('.pcard')){ openDetail(e.target.dataset.id); }
 if(e.key==='Enter'&&e.target&&e.target.matches('.tut')){ e.target.click(); }
});
/* drag & drop: juego + reorder */
document.addEventListener('dragstart',e=>{
 const gi=e.target.closest&&e.target.closest('.gitem'); if(gi){ e.dataTransfer.setData('text/plain',gi.dataset.id); e.dataTransfer.effectAllowed='move'; return; }
 const row=e.target.closest&&e.target.closest('[data-row]'); if(row){ row.classList.add('dragging'); e.dataTransfer.setData('text/plain',row.dataset.row); e.dataTransfer.effectAllowed='move'; }
});
document.addEventListener('dragend',e=>{ const row=e.target.closest&&e.target.closest('[data-row]'); if(row)row.classList.remove('dragging'); $$('.row.dragover').forEach(r=>r.classList.remove('dragover')); });
document.addEventListener('dragover',e=>{
 const bin=e.target.closest&&e.target.closest('.bin'); if(bin){ e.preventDefault(); bin.classList.add('over'); return; }
 const row=e.target.closest&&e.target.closest('[data-row]'); if(row){ e.preventDefault(); $$('.row.dragover').forEach(r=>r.classList.remove('dragover')); row.classList.add('dragover'); }
});
document.addEventListener('dragleave',e=>{ const bin=e.target.closest&&e.target.closest('.bin'); if(bin)bin.classList.remove('over'); });
document.addEventListener('drop',e=>{
 const bin=e.target.closest&&e.target.closest('.bin');
 if(bin){ e.preventDefault(); bin.classList.remove('over'); gameDrop(bin.dataset.bin,e.dataTransfer.getData('text/plain')); return; }
 const row=e.target.closest&&e.target.closest('[data-row]');
 if(row){ e.preventDefault(); row.classList.remove('dragover');
  const src=e.dataTransfer.getData('text/plain'),dst=row.dataset.row; if(!src||src===dst)return;
  const u=currentUser(); if(!u)return;
  const mine=S.products.filter(p=>p.vendedorId===u.id).sort((a,b)=>a.orden-b.orden);
  const from=mine.findIndex(p=>p.id===src),to=mine.findIndex(p=>p.id===dst);
  if(from<0||to<0)return;
  const moved=mine.splice(from,1)[0]; mine.splice(to,0,moved); mine.forEach((p,i)=>p.orden=i);
  save(); renderMy(); toast('Orden actualizado',{icon:'drag'});
 }
});

/* ---------- EFECTOS ---------- */
let revealObs=null;
function observeReveal(root){
 if(!('IntersectionObserver' in window)){ $$('.rv',root||document).forEach(e=>e.classList.add('in')); return; }
 if(!revealObs) revealObs=new IntersectionObserver(es=>{es.forEach(en=>{if(en.isIntersecting){en.target.classList.add('in');revealObs.unobserve(en.target);}});},{threshold:.08,rootMargin:'0px 0px -40px 0px'});
 $$('.rv',root||document).forEach((e,i)=>{ if(!e.classList.contains('in')){ e.style.transitionDelay=(Math.min(i,6)*60)+'ms'; revealObs.observe(e); } });
}
function initEffects(){
 const nav=$('#nav'),prog=$('#progress'),top=$('#totop');
 const secs=$$('main section[id]');
 const links=$$('#navlinks a').concat($$('#mobile a'));
 let ticking=false;
 function onScroll(){
  if(ticking)return; ticking=true;
  requestAnimationFrame(()=>{
   const y=window.scrollY,h=document.documentElement.scrollHeight-window.innerHeight;
   prog.style.width=(h>0?(y/h*100):0)+'%';
   nav.classList.toggle('solid',y>40);
   top.classList.toggle('show',y>700);
   let cur=secs[0]?secs[0].id:'';
   secs.forEach(s=>{ if(s.getBoundingClientRect().top<=140) cur=s.id; });
   links.forEach(l=>l.classList.toggle('active',l.dataset.target===cur));
   const hf=$('#hero-frame');
   if(hf&&!reduceMotion&&y<900){ hf.style.transform='rotate(-1.2deg) translateY('+(y*0.06)+'px)'; }
   ticking=false;
  });
 }
 window.addEventListener('scroll',onScroll,{passive:true}); onScroll();
 /* contadores */
 const counters=$$('[data-count]');
 if('IntersectionObserver' in window){
  const co=new IntersectionObserver(es=>{es.forEach(en=>{ if(!en.isIntersecting)return; co.unobserve(en.target);
   const el=en.target,to=Number(el.dataset.count),t0=performance.now(),dur=1100;
   const step=t=>{const k=clamp((t-t0)/dur,0,1);el.textContent=Math.round(to*(1-Math.pow(1-k,3)));if(k<1)requestAnimationFrame(step);};
   requestAnimationFrame(step); });},{threshold:.4});
  counters.forEach(c=>co.observe(c));
 } else counters.forEach(c=>c.textContent=c.dataset.count);
 observeReveal();
 /* hojas del hero */
 const cv=$('#hero-canvas');
 if(cv&&!reduceMotion){
  const ctx=cv.getContext('2d'); let W=0,H=0,raf=null,visible=true;
  const dpr=Math.min(window.devicePixelRatio||1,2);
  const cols=['rgba(184,242,74,.5)','rgba(127,227,176,.45)','rgba(37,161,95,.4)','rgba(245,165,36,.32)'];
  const leaves=[];
  function size(){ const r=cv.getBoundingClientRect(); W=r.width;H=r.height; cv.width=Math.round(W*dpr);cv.height=Math.round(H*dpr); ctx.setTransform(dpr,0,0,dpr,0,0); }
  function seed(){ leaves.length=0; const n=window.innerWidth<700?16:28;
   for(let i=0;i<n;i++) leaves.push({x:Math.random()*W,y:Math.random()*H,s:6+Math.random()*13,vy:.16+Math.random()*.5,vx:.1+Math.random()*.45,a:Math.random()*Math.PI*2,va:(Math.random()-.5)*.014,c:cols[i%cols.length]}); }
  function draw(){
   ctx.clearRect(0,0,W,H);
   for(const lf of leaves){
    lf.y+=lf.vy; lf.x+=lf.vx+Math.sin(lf.y/70)*.28; lf.a+=lf.va;
    if(lf.y>H+30){lf.y=-30;lf.x=Math.random()*W;} if(lf.x>W+30)lf.x=-30;
    ctx.save(); ctx.translate(lf.x,lf.y); ctx.rotate(lf.a); ctx.fillStyle=lf.c;
    ctx.beginPath(); ctx.moveTo(0,0); ctx.bezierCurveTo(lf.s*.7,-lf.s*.6,lf.s*1.7,-lf.s*.25,lf.s*2,lf.s*.35);
    ctx.bezierCurveTo(lf.s*1.2,lf.s*.95,lf.s*.25,lf.s*.7,0,0); ctx.fill(); ctx.restore();
   }
   raf=requestAnimationFrame(draw);
  }
  size(); seed(); draw();
  window.addEventListener('resize',()=>{size();seed();},{passive:true});
  if('IntersectionObserver' in window){
   new IntersectionObserver(es=>{es.forEach(en=>{ visible=en.isIntersecting;
    if(visible&&!raf){raf=requestAnimationFrame(draw);} else if(!visible&&raf){cancelAnimationFrame(raf);raf=null;} });},{threshold:.02}).observe(cv);
  }
  document.addEventListener('visibilitychange',()=>{ if(document.hidden&&raf){cancelAnimationFrame(raf);raf=null;} else if(!document.hidden&&visible&&!raf){raf=requestAnimationFrame(draw);} });
 }
}

/* ---------- INIT ---------- */
function init(){
 load();
 renderStatic();
 renderRR(); renderGame(); renderModules();
 renderTabs(); setTab('catalogo'); renderMy(); renderAdmin(); renderProfile(); renderCart(); fillPubForm();
 renderPhone(); renderSchema(); renderStack();
 syncFormInputs(); goStep(S.step||1); updateSummary();
 hydrateIcons(); initEffects();
 setTimeout(()=>{ observeReveal(); },200);
}
if(document.readyState==='loading') document.addEventListener('DOMContentLoaded',init); else init();
</script>
