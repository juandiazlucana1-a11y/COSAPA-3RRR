<!-- ============ HERO ============ -->
<section class="hero" id="inicio">
  <canvas id="hero-canvas"></canvas>
  <span class="aura" style="width:420px;height:420px;background:rgba(184,242,74,.22);top:-90px;left:-90px"></span>
  <span class="aura" style="width:380px;height:380px;background:rgba(46,155,214,.2);bottom:-120px;right:6%;animation-delay:-6s"></span>
  <div class="wrap hero-grid">
    <div>
